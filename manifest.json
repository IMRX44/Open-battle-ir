{
  "manifest_version": 3,
  "name": "OpenBattle Assistant",
  "version": "1.0.0",
  "default_locale": "fa",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "OpenBattle Assistant",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://openbattle.ir/*",
    "https://*.openbattle.ir/*",
    "https://openfront.io/*",
    "https://*.openfront.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://openbattle.ir/*",
        "https://*.openbattle.ir/*",
        "https://openfront.io/*",
        "https://*.openfront.io/*"
      ],
      "js": [
        "src/page/bridge.js",
        "src/page/bot.js",
        "src/page/planner.js",
        "src/page/boot.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://openbattle.ir/*",
        "https://*.openbattle.ir/*",
        "https://openfront.io/*",
        "https://*.openfront.io/*"
      ],
      "js": [
        "src/ui/settings.js",
        "src/ui/panel.js",
        "src/ui/content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ]
}
